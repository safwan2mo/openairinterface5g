    <command><![CDATA[for i in $(seq 1 20); do docker logs rfsim5g-oai-cucp-0 2>&1 | grep -q "setup complete" && docker logs rfsim5g-oai-cucp-1 2>&1 | grep -q "setup complete" && exit 0; sleep 1; done; exit 1]]></command>
